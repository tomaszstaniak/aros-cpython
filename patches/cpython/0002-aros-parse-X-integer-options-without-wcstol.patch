From 1dde5de81736c826711d5a951b3d218a89ebd477 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:02:12 +0200
Subject: [PATCH 02/22] aros: parse -X integer options without wcstol()

The ABIv11 C library declares wcstol() in <wchar.h> but marks it not
implemented, so initconfig.c does not compile. Replace it there with a
base 10 parser that returns the same value, end pointer and ERANGE as
wcstol() (checked against the host C library for signs, white space,
empty input and both overflow edges).
---
 Python/initconfig.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/Python/initconfig.c b/Python/initconfig.c
index fd5ad65..1145b40 100644
--- a/Python/initconfig.c
+++ b/Python/initconfig.c
@@ -1820,6 +1820,46 @@ config_init_hash_seed(PyConfig *config)
 }
 
 
+#ifdef __AROS__
+/* ABIv11 crt.library declares wcstol() but does not implement it. This is
+   the base 10 part of it that config_wstr_to_int() needs: optional white
+   space and sign, then digits; ERANGE on overflow; *endptr at the first
+   character not used, or at nptr if there are no digits. */
+static long
+aros_wcstol10(const wchar_t *nptr, wchar_t **endptr)
+{
+    const wchar_t *p = nptr;
+    unsigned long v = 0, lim;
+    int neg = 0, any = 0, over = 0;
+
+    while (*p == L' ' || (*p >= L'\t' && *p <= L'\r')) {
+        p++;
+    }
+    if (*p == L'+' || *p == L'-') {
+        neg = (*p == L'-');
+        p++;
+    }
+    lim = neg ? (unsigned long)LONG_MAX + 1 : (unsigned long)LONG_MAX;
+    for (; *p >= L'0' && *p <= L'9'; p++) {
+        unsigned long d = (unsigned long)(*p - L'0');
+        any = 1;
+        if (over || v > (lim - d) / 10) {
+            over = 1;
+        }
+        else {
+            v = v * 10 + d;
+        }
+    }
+    *endptr = (wchar_t *)(any ? p : nptr);
+    if (over) {
+        errno = ERANGE;
+        return neg ? LONG_MIN : LONG_MAX;
+    }
+    return neg ? (long)(0 - v) : (long)v;
+}
+#define wcstol(nptr, endptr, base) aros_wcstol10((nptr), (endptr))
+#endif
+
 static int
 config_wstr_to_int(const wchar_t *wstr, int *result)
 {
