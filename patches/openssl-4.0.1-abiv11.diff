diff --git a/Configurations/15-aros-v11.conf b/Configurations/15-aros-v11.conf
new file mode 100644
index 0000000..fed5d61
--- /dev/null
+++ b/Configurations/15-aros-v11.conf
@@ -0,0 +1,18 @@
+## ABIv11 AROS (AROS One / deadwood2 line) on x86_64, static libraries only.
+## CC, CFLAGS, AR and RANLIB come from the environment of the build script.
+my %targets = (
+    "aros-v11-x86_64" => {
+        inherit_from     => [ "BASE_unix" ],
+        sys_id           => "AROS",
+        CC               => "$ENV{'CC'}",
+        CFLAGS           => "$ENV{'AROS_CFLAGS'}",
+        cflags           => add("-DNO_FORK -DOPENSSL_NO_SECURE_MEMORY -D_XOPEN_SOURCE=600 -D__BSD_VISIBLE=1"),
+        ARFLAGS          => "qc",
+        RANLIB           => "$ENV{'RANLIB'}",
+        ex_libs          => "-ljitterentropy -lnet -lpthread",
+        bn_ops           => "SIXTY_FOUR_BIT_LONG",
+        perlasm_scheme   => "elf",
+        thread_scheme    => "pthreads",
+        perl_platform    => 'Unix',
+    },
+);
