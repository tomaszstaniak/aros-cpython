diff --git a/include/internal/sockets.h b/include/internal/sockets.h
index c5f2978..658fdd2 100644
--- a/include/internal/sockets.h
+++ b/include/internal/sockets.h
@@ -118,7 +118,7 @@ typedef size_t socklen_t; /* Currently appears to be missing on VMS */
 #endif
 
 #ifdef OPENSSL_SYS_UNIX
-#ifndef OPENSSL_SYS_TANDEM
+#if !defined(OPENSSL_SYS_TANDEM) && !defined(OPENSSL_SYS_AROS)
 #include <poll.h>
 #endif
 #include <errno.h>
@@ -212,6 +212,19 @@ static ossl_inline int writesocket_ex(int s, const void *b, int n, int f)
 }
 #define ioctlsocket(a, b, c) ioctl(a, b, c)
 #define closesocket(s) close(s)
+#elif defined(OPENSSL_SYS_AROS)
+/*
+ * ABIv11 AROS has no descriptor layer shared by files and sockets: a
+ * bsdsocket.library socket is numbered from 0 like a C library file, so
+ * read(), write(), close() and ioctl() on it act on the C library file with
+ * that number (stdin for the first socket). Use the socket library's calls.
+ */
+#include <proto/socket.h>
+#define ioctlsocket(a, b, c) IoctlSocket((a), (b), (char *)(c))
+#define closesocket(s) CloseSocket(s)
+#define readsocket(s, b, n) recv((s), (b), (n), 0)
+#define writesocket(s, b, n) send((s), (b), (n), 0)
+#define writesocket_ex(s, b, n, f) send((s), (b), (n), (f))
 #else
 #define ioctlsocket(a, b, c) ioctl(a, b, c)
 #define closesocket(s) close(s)
diff --git a/providers/implementations/rands/seeding/rand_unix.c b/providers/implementations/rands/seeding/rand_unix.c
index 1af996b..4fe9d06 100644
--- a/providers/implementations/rands/seeding/rand_unix.c
+++ b/providers/implementations/rands/seeding/rand_unix.c
@@ -325,12 +325,59 @@ static ssize_t sysctl_random(char *buf, size_t buflen)
 #endif
 #endif
 
+#if defined(OPENSSL_SYS_AROS)
+/*
+ * ABIv11 AROS has no operating system entropy source: no getentropy() or
+ * getrandom() in crt.library and no random device. The CPU jitter entropy
+ * library is used instead; its start-up health tests run once, and a fresh
+ * collector per call keeps this safe to call from several threads.
+ */
+#include <pthread.h>
+
+/*
+ * From jitterentropy.h; that header pulls in helpers that need more of
+ * <unistd.h> than _XOPEN_SOURCE=600 exposes, and only these are used.
+ */
+struct rand_data;
+int jent_entropy_init(void);
+struct rand_data *jent_entropy_collector_alloc(unsigned int osr, unsigned int flags);
+void jent_entropy_collector_free(struct rand_data *entropy_collector);
+ssize_t jent_read_entropy(struct rand_data *entropy_collector, char *data, size_t len);
+
+static pthread_once_t aros_jent_once = PTHREAD_ONCE_INIT;
+static int aros_jent_ok;
+
+static void aros_jent_init(void)
+{
+    aros_jent_ok = (jent_entropy_init() == 0);
+}
+
+static ssize_t aros_jitter_random(void *buf, size_t buflen)
+{
+    struct rand_data *ec;
+    ssize_t got;
+
+    pthread_once(&aros_jent_once, aros_jent_init);
+    if (!aros_jent_ok)
+        return -1;
+    ec = jent_entropy_collector_alloc(0, 0);
+    if (ec == NULL)
+        return -1;
+    got = jent_read_entropy(ec, buf, buflen);
+    jent_entropy_collector_free(ec);
+    return got == (ssize_t)buflen ? got : -1;
+}
+#endif
+
 /*
  * syscall_random(): Try to get random data using a system call
  * returns the number of bytes returned in buf, or < 0 on error.
  */
 static ssize_t syscall_random(void *buf, size_t buflen)
 {
+#if defined(OPENSSL_SYS_AROS)
+    return aros_jitter_random(buf, buflen);
+#else
     /*
      * Note: 'buflen' equals the size of the buffer which is used by the
      * get_entropy() callback of the RAND_DRBG. It is roughly bounded by
@@ -404,6 +451,7 @@ static ssize_t syscall_random(void *buf, size_t buflen)
     errno = ENOSYS;
     return -1;
 #endif
+#endif /* OPENSSL_SYS_AROS */
 }
 #endif /* defined(OPENSSL_RAND_SEED_GETRANDOM) */
 
